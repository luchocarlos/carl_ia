{
  "name": "Carl",
  "version": "1.0.0",
  "colors": {
    "background": "#09090b",
    "panel": "#111114",
    "foreground": "#f4f4f5",
    "muted": "#a1a1aa",
    "accentStart": "#6366f1",
    "accentEnd": "#22d3ee",
    "accentSoft": "#a5b4fc",
    "success": "#34d399",
    "warning": "#fbbf24",
    "danger": "#f87171"
  },
  "typography": {
    "family": "Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, sans-serif",
    "sizes": {
      "hero": "3rem",
      "title": "1.25rem",
      "body": "0.875rem",
      "caption": "0.6875rem"
    }
  },
  "pairs": [
    { "fg": "foreground", "bg": "background", "min": 4.5, "usage": "texto principal" },
    { "fg": "foreground", "bg": "panel", "min": 4.5, "usage": "texto en tarjetas" },
    { "fg": "muted", "bg": "background", "min": 4.5, "usage": "texto secundario" },
    { "fg": "muted", "bg": "panel", "min": 4.5, "usage": "texto secundario en tarjetas" },
    { "fg": "accentSoft", "bg": "background", "min": 4.5, "usage": "acento en texto" },
    { "fg": "success", "bg": "background", "min": 4.5, "usage": "consumo disponible" },
    { "fg": "warning", "bg": "background", "min": 4.5, "usage": "consumo al 80 %" },
    { "fg": "danger", "bg": "background", "min": 4.5, "usage": "consumo al 100 %" },
    { "fg": "accentStart", "bg": "background", "min": 3.0, "usage": "título grande con gradiente" }
  ]
}
