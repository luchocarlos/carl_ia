HOST=0.0.0.0
PORT=1337
PUBLIC_URL=
FRONTEND_URL=

APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Panel admin de Strapi. En producción con 512 MB usa false (no se compila).
SERVE_ADMIN=true

DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Seguridad opcional: si se define, /api/ia/* exige el header X-API-Key
IA_API_KEY=

# Proveedor por defecto. Usa "auto" para la cadena de respaldo.
IA_DEFAULT_PROVIDER=auto
# Opcional: si está vacío se usa el modelo gratis del catálogo.
IA_DEFAULT_MODEL=

# Cadena de respaldo para provider=auto, formato proveedor:modelo
# Ejemplo: groq:llama-3.3-70b-versatile,google:gemini-2.5-flash
IA_FALLBACK_CHAIN=

# Modelo por proveedor (opcional). Útil cuando no hay defaultModel en el catálogo.
# IA_MODEL_GROQ=
# IA_MODEL_CEREBRAS=
# IA_MODEL_MISTRAL=
# IA_MODEL_GOOGLE=
# IA_MODEL_OLLAMA=

# Credenciales: configura solo los proveedores que vayas a usar
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=carl_ia
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OPENCODE_API_KEY=

# Contrato del frontend Carl: /api/chat y /api/usage
# Puntos diarios por usuario y cupo global compartido.
IA_DAILY_LIMIT=30
IA_GLOBAL_DAILY_LIMIT=300
# Archivo donde se persiste el consumo (por defecto .data/usage.json).
IA_USAGE_FILE=
# Confía en X-Forwarded-For cuando hay un proxy delante.
PROXY=true
