{
  "defaultProvider": "groq",
  "providers": {
    "groq": {
      "name": "Groq",
      "api": "openai",
      "baseURL": "https://api.groq.com/openai/v1",
      "envKey": "GROQ_API_KEY",
      "free": true,
      "defaultModel": "llama-3.3-70b-versatile"
    },
    "cerebras": {
      "name": "Cerebras",
      "api": "openai",
      "baseURL": "https://api.cerebras.ai/v1",
      "envKey": "CEREBRAS_API_KEY",
      "free": true
    },
    "mistral": {
      "name": "Mistral",
      "api": "openai",
      "baseURL": "https://api.mistral.ai/v1",
      "envKey": "MISTRAL_API_KEY",
      "free": true
    },
    "google": {
      "name": "Google Gemini",
      "api": "google",
      "baseURL": "https://generativelanguage.googleapis.com/v1beta",
      "envKey": "GEMINI_API_KEY",
      "free": true
    },
    "opencode": {
      "name": "OpenCode (pagado o Go)",
      "api": "openai",
      "baseURL": "https://opencode.ai/inference/openai/v1",
      "envKey": "OPENCODE_API_KEY",
      "free": false,
      "soloEnOpenCode": true,
      "note": "Los modelos *-free de OpenCode solo funcionan dentro de OpenCode; desde una web responden 429/403."
    },
    "ollama": {
      "name": "Ollama (local)",
      "api": "openai",
      "baseURL": "http://127.0.0.1:11434/v1",
      "envKey": null,
      "free": true,
      "note": "Requiere Ollama corriendo en el servidor del backend."
    }
  }
}
